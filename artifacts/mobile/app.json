{
  "expo": {
    "name": "Lucky777 - Satta Matka",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lucky777",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0a0a0a",
      "package": "com.lucky777.sattamatka",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#0a0a0a"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "afd6453d-c6c2-4121-bb46-de7d5a656eef"
      }
    },
    "owner": "kashishchaudhari"
  }
}
